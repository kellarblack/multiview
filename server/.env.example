# multiview sync backend — environment template
#
# Copy to `.env` or export these in your process manager. Nothing here is read
# automatically; the server only looks at real environment variables. Accounts
# stay OFF in the static app until sync.js is loaded and configured.

# ── network ────────────────────────────────────────────────────────────────
MV_HOST=127.0.0.1
MV_PORT=8787
# Public site origin(s) allowed to call the API, comma separated.
MV_ORIGINS=https://multiview.cc
# Used for share links and Stripe redirects.
MV_PUBLIC_URL=https://multiview.cc

# ── database ───────────────────────────────────────────────────────────────
# SQLite file. Point this at a path on a persistent volume.
MV_DB=/var/lib/multiview/multiview.db

# ── accounts ───────────────────────────────────────────────────────────────
# Length of the one-per-IP free trial, in days (0 disables trials).
MV_TRIAL_DAYS=7
# Boards a non-Pro account may sync.
MV_FREE_LIMIT=2
# Sessions expire after this many days of inactivity.
MV_SESSION_DAYS=30
# Set to 1 ONLY when a reverse proxy overwrites X-Forwarded-For.
MV_TRUST_PROXY=0
# HMAC key for hashed visitor IPs. Leave empty to generate one into the DB.
MV_IP_SECRET=

# ── billing (optional) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── diagnostics ────────────────────────────────────────────────────────────
# 1 = log request lines to stderr (never bodies).
MV_VERBOSE=0
